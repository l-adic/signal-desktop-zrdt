{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  // demo/ holds node scripts run with `node --import tsx` (launch harness,
  // villain, rules), outside Signal's ts/ suffix scheme.
  "extends": ["../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["**/*.ts"],
      "env": { "node": true },
      "rules": {
        "signal-desktop/enforce-file-suffix": "off",
        "signal-desktop/enforce-license-comments": "off",
        "eslint/no-restricted-globals": ["error"]
      }
    }
  ]
}
